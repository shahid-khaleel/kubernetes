IAM Policy for S3

s3-policy.json:


{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:PutObject","s3:GetObject","s3:DeleteObject"],
      "Resource": "arn:aws:s3:::testdata/*"
    },
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::testdata"
    }
  ]
}

#
Create Policy
aws iam create-policy --policy-name s3-app-policy --policy-document file://s3-policy.json


